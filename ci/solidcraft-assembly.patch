+
+#[test]
+fn authored_occurrence_names_are_addressable_unique_and_transactional() {
+    let mut s = Session::default();
+    run(&mut s, "component.create", json!({"name":"Leaf","occurrence_name":"fixed_leaf"}));
+    run(&mut s, "occurrence.copy", json!({"component":"Leaf","occurrence_name":"moving_leaf"}));
+    run(&mut s, "occurrence.move", json!({"occurrence":"moving_leaf","translate":[10,0,0]}));
+    let leaf = s.doc.occurrences.iter().find(|o| o.name == "moving_leaf").unwrap();
+    assert_eq!(leaf.transform[3][0], 10.0);
+    assert_eq!(s.doc.occurrences.iter().find(|o| o.name == "fixed_leaf").unwrap().transform[3][0], 0.0);
+    let before = serde_json::to_value(&s.doc).unwrap();
+    for name in [json!("moving_leaf"), json!(""), json!("123"), json!("ROOT"), json!(7)] {
+        assert!(s.execute("occurrence.copy", &json!({"component":"Leaf","occurrence_name":name})).is_err());
+        assert!(s.execute("component.create", &json!({"name":"Other","occurrence_name":name})).is_err());
+        assert_eq!(serde_json::to_value(&s.doc).unwrap(), before);
+    }
+}
