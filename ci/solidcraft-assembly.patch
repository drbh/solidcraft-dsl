+/// Authored occurrence names let static scripts address instances without guessing ids.
+fn authored_occurrence_name(s: &Session, p: &Value, cmd: &str) -> Result<Option<String>> {
+    let Some(v) = p.get("occurrence_name") else { return Ok(None) };
+    let name = v
+        .as_str()
+        .filter(|n| !n.trim().is_empty() && n.len() <= 1024)
+        .ok_or_else(|| bad(cmd, "occurrence_name must be a nonempty string of at most 1024 bytes"))?;
+    if name.eq_ignore_ascii_case("root") || name.parse::<u64>().is_ok() || s.doc.occurrences.iter().any(|o| o.name == name) {
+        return Err(bad(cmd, "occurrence_name must be unique, nonnumeric, and not root"));
+    }
+    Ok(Some(name.to_string()))
+}
