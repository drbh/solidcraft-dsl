{
  "version": 1,
  "defaults": false,
  "requests": [
    { "id": "print-3mf", "kind": "export", "format": "3mf", "layout": "plate" },
    { "id": "preview-glb", "kind": "export", "format": "glb", "layout": "plate" },
    { "id": "print-stl", "kind": "export", "format": "stl", "layout": "plate" },
    { "id": "print-check", "kind": "commands", "layout": "plate",
      "commands": [ { "command": "inspect.measure", "params": {} } ] },
    { "id": "plate-view", "kind": "snapshot", "layout": "plate", "options": { "view": "iso" } }
  ],
  "layouts": {
    "plate": {
      "bed": [256, 256],
      "parts": [
        { "id": "Tube", "select": { "bodies": ["Tube"] } },
        { "id": "Eyepiece", "select": { "bodies": ["Eyepiece"] } },
        { "id": "Cell", "select": { "bodies": ["Cell"] }, "rotate": [ { "axis": [1, 0, 0], "angle": "180 deg" } ] },
        { "id": "Spacer", "select": { "bodies": ["Spacer"] } },
        { "id": "Retainer", "select": { "bodies": ["Retainer"] } }
      ]
    }
  }
}
