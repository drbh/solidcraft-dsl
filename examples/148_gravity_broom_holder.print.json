{
  "version": 1,
  "defaults": false,
  "requests": [
    { "id": "print-3mf", "kind": "export", "format": "3mf", "layout": "plate" },
    { "id": "print-stl", "kind": "export", "format": "stl", "layout": "plate" },
    { "id": "preview-glb", "kind": "export", "format": "glb", "layout": "plate" },
    { "id": "print-check", "kind": "commands", "layout": "plate",
      "commands": [ { "command": "inspect.measure", "params": {} } ] },
    { "id": "fit-check", "kind": "commands",
      "commands": [ { "command": "inspect.interference", "params": { "bodies": ["Holder", "Cam", "ORing", "Pole"] } } ] },
    { "id": "plate-view", "kind": "snapshot", "layout": "plate", "options": { "view": "iso" } }
  ],
  "layouts": {
    "plate": {
      "bed": [256, 256],
      "spacing": "8 mm",
      "parts": [
        { "id": "holder", "select": { "bodies": ["Holder"] }, "rotate": [ { "axis": [1, 0, 0], "angle": "90 deg" } ] },
        { "id": "cam", "select": { "bodies": ["Cam"] }, "rotate": [ { "axis": [1, 0, 0], "angle": "90 deg" } ] }
      ]
    }
  }
}
