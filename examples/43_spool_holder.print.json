{
  "version": 1,
  "defaults": false,
  "requests": [
    { "id": "print-3mf", "kind": "export", "format": "3mf", "layout": "plate" },
    { "id": "preview-glb", "kind": "export", "format": "glb", "layout": "plate" },
    { "id": "print-stl", "kind": "export", "format": "stl", "layout": "plate" },
    { "id": "print-check", "kind": "commands", "layout": "plate",
      "commands": [ { "command": "inspect.measure", "params": {} } ] },
    { "id": "single-view", "kind": "snapshot", "layout": "plate", "options": { "view": "iso" } }
  ],
  "layouts": {
    "plate": { "spacing": "8 mm", "parts": [
      { "id": "Stand", "select": { "bodies": ["Stand"] }, "at": [0, 0] },
      { "id": "RollerA", "select": { "bodies": ["RollerA"] },
        "rotate": [{"axis": [1, 0, 0], "angle": "90 deg"}], "at": ["10 mm", "100 mm"] },
      { "id": "RollerB", "select": { "bodies": ["RollerB"] },
        "rotate": [{"axis": [1, 0, 0], "angle": "90 deg"}], "at": ["50 mm", "100 mm"] }
    ] }
  }
}
