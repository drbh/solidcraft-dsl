{
  "version": 1,
  "defaults": false,
  "requests": [
    { "id": "joints", "kind": "commands",
      "commands": [ { "command": "inspect.interference", "params": { "bodies": ["Launch_Launcher", "Launch_Plunger", "In_Straight", "Loop_Loop", "Out_Straight", "Turn_Curve"] } } ] },
    { "id": "flat-3mf", "kind": "export", "format": "3mf", "layout": "flat" },
    { "id": "flat-stl", "kind": "export", "format": "stl", "layout": "flat" },
    { "id": "loop-3mf", "kind": "export", "format": "3mf", "layout": "loop" },
    { "id": "loop-stl", "kind": "export", "format": "stl", "layout": "loop" },
    { "id": "preview-glb", "kind": "export", "format": "glb", "layout": "flat" },
    { "id": "print-check", "kind": "commands", "layout": "loop",
      "commands": [ { "command": "inspect.measure", "params": {} } ] },
    { "id": "flat-view", "kind": "snapshot", "layout": "flat", "options": { "view": "iso" } },
    { "id": "loop-view", "kind": "snapshot", "layout": "loop", "options": { "view": "iso" } }
  ],
  "layouts": {
    "flat": {
      "bed": [256, 256],
      "parts": [
        { "id": "Launcher", "select": { "bodies": ["Launch_Launcher"] } },
        { "id": "Plunger", "select": { "bodies": ["Launch_Plunger"] } },
        { "id": "Straight", "select": { "bodies": ["In_Straight"] }, "rotate": [ { "axis": [0, 0, 1], "angle": "90 deg" } ] },
        { "id": "Curve", "select": { "bodies": ["Turn_Curve"] } }
      ]
    },
    "loop": {
      "bed": [256, 256],
      "parts": [
        { "id": "Loop", "select": { "bodies": ["Loop_Loop"] } }
      ]
    }
  }
}
