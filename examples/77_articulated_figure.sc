// 77. Print-in-place articulated desk figure: a poseable robot that comes off the bed already jointed.
//
// It prints lying on its back, exactly as modelled: Z is up from the bed, Y runs from the feet
// (y ~ 2) to the top of the head (y ~ 158), X across, the figure's centre line at x = 0. Every
// part is a slab T thick standing on the bed; nothing needs supports and nothing is assembled.
//
// Two joint types, every gap at least `clearance` (0.35 mm):
//   Hinge (neck, shoulders, elbows, wrists, hips, knees, ankles): an axis along X at height zh.
//     The parent ends in two outer knuckles, the child in one middle knuckle between them, with
//     an axial gap. The outer knuckles carry 45 deg cone pins pointing inward into conical
//     sockets in the middle knuckle; each socket is its pin grown by `clearance` normal to the
//     surface, so the joint turns but cannot come apart. Knuckles are cylinders of radius rk cut
//     flat by the bed: the axis sits at zh = rk cos 45, so the knuckle's underside starts at 45 deg
//     and its top is flush with the slab top (T = zh + rk). Each body's slab stops rk + clearance
//     short of the axis wherever the other body's knuckle turns.
//   Turret (shoulders and hips, the second axis): a Z pivot that spreads the limb sideways in the
//     bed plane. The torso keeps a floor_t floor under a round pocket; the limb's link sits on it
//     as a disc clearance above, round a stem with a 45 deg mushroom head that is part of the
//     torso, in a countersunk hole. The disc's underside is a short ledge printed clearance above
//     the floor, as on common flexi prints; keep the first layers slow.
// So each shoulder and hip is a link body with two axes (turret then hinge), and each limb has a
// hinge at every joint.
//
// Print: as modelled, one plate, no supports, PLA or PETG at 0.2 mm layers or finer, line width
// 0.4 mm. The 0.35 mm gaps are under two layers, so turn off "ironing" and keep cooling on. After
// printing, work each joint gently through its range to break the joints free. If they fuse, raise
// clearance to 0.4-0.45 mm; if they flop, lower it to 0.3 mm. Print the elbow alone first as a test.
//
// The pose parameters (all 0 deg = the print pose) swing the parts about their real axes, from the
// tips back to the body, so each pivot is still where it was modelled: positive hinge angles lift
// the child off the bed, positive spreads swing arms and legs outward. Generated by gen_figure.py.
design ArticulatedFigure units mm

// Fit
param clearance = 0.35 mm      // every gap between moving parts
// Hinges
param rk = 4 mm                // knuckle radius
param ko = 3 mm                // outer knuckle length along the axis
param rc = 1.5 mm              // cone pin base radius
param tip = 0.3 mm             // pins and sockets stop this short of a point
// Turrets
param floor_t = 2.4 mm         // torso floor under each turret
param stem_r = 2.2 mm
param head_r = 3.4 mm          // the stem's 45 deg mushroom head
param disc_r = 6 mm            // the link's disc round the stem

// Proportions (y up the figure)
param torso_w = 34 mm
param torso_bottom = 92 mm
param torso_top = 130 mm
param neck_w = 12 mm
param neck_y = 134 mm
param head_w = 24 mm
param head_h = 24 mm
param arm_w = 12 mm
param shoulder_x = 13 mm       // turret centre, inside the torso's top corner
param shoulder_y = 122 mm
param shoulder_hinge_y = 114 mm
param elbow_y = 86 mm
param wrist_y = 62 mm
param hand_end = 46 mm
param leg_w = 14 mm
param hip_x = 10 mm            // leg centre line and turret centre
param hip_y = 95.5 mm
param hip_hinge_y = 84 mm
param knee_y = 54 mm
param ankle_y = 22 mm
param foot_end = 2 mm

// Pose (0 = as printed)
param neck = 0 deg
param shoulder_spread = 0 deg
param shoulder = 0 deg
param elbow = 0 deg
param wrist = 0 deg
param hip_spread = 0 deg
param hip = 0 deg
param knee = 0 deg
param ankle = 0 deg

let zh = rk*cos(45 deg)
let T = zh + rk
let c2 = clearance*sqrt(2)
let arm_x0 = torso_w/2 + clearance
let arm_x1 = arm_x0 + arm_w
let leg_x0 = hip_x - leg_w/2
let leg_x1 = hip_x + leg_w/2

// ==== Slabs, in the print pose
sketch TorsoSk on XY {
  rect rounded o = (-torso_w/2, torso_bottom) (torso_w/2, torso_top) radius 5 mm
  fix o
}
extrude TorsoSlab from TorsoSk distance T new -> body Torso
box NeckTab size neck_w (neck_y - torso_top + 1 mm) T corner (-neck_w/2, torso_top - 1 mm, 0) join targets Torso
sketch HeadSk on XY {
  rect rounded o = (-head_w/2, neck_y) (head_w/2, neck_y + head_h) radius 5 mm
  fix o
}
extrude HeadSlab from HeadSk distance T new -> body Head
box ShoulderRBlock size arm_w (shoulder_y - 2 mm - shoulder_hinge_y) T corner (arm_x0, shoulder_hinge_y, 0) new -> body ShoulderR
box UpperArmRSlab size arm_w (shoulder_hinge_y - elbow_y) T corner (arm_x0, elbow_y, 0) new -> body UpperArmR
box ForearmRSlab size arm_w (elbow_y - wrist_y) T corner (arm_x0, wrist_y, 0) new -> body ForearmR
box HandRSlab size arm_w (wrist_y - hand_end) T corner (arm_x0, hand_end, 0) new -> body HandR
box HipRBlock size leg_w (torso_bottom - clearance - hip_hinge_y) T corner (leg_x0, hip_hinge_y, 0) new -> body HipR
box ThighRSlab size leg_w (hip_hinge_y - knee_y) T corner (leg_x0, knee_y, 0) new -> body ThighR
box ShinRSlab size leg_w (knee_y - ankle_y) T corner (leg_x0, ankle_y, 0) new -> body ShinR
box FootRSlab size leg_w (ankle_y - foot_end) T corner (leg_x0, foot_end, 0) new -> body FootR
box ShoulderLBlock size arm_w (shoulder_y - 2 mm - shoulder_hinge_y) T corner ((-arm_x1), shoulder_hinge_y, 0) new -> body ShoulderL
box UpperArmLSlab size arm_w (shoulder_hinge_y - elbow_y) T corner ((-arm_x1), elbow_y, 0) new -> body UpperArmL
box ForearmLSlab size arm_w (elbow_y - wrist_y) T corner ((-arm_x1), wrist_y, 0) new -> body ForearmL
box HandLSlab size arm_w (wrist_y - hand_end) T corner ((-arm_x1), hand_end, 0) new -> body HandL
box HipLBlock size leg_w (torso_bottom - clearance - hip_hinge_y) T corner ((-leg_x1), hip_hinge_y, 0) new -> body HipL
box ThighLSlab size leg_w (hip_hinge_y - knee_y) T corner ((-leg_x1), knee_y, 0) new -> body ThighL
box ShinLSlab size leg_w (knee_y - ankle_y) T corner ((-leg_x1), ankle_y, 0) new -> body ShinL
box FootLSlab size leg_w (ankle_y - foot_end) T corner ((-leg_x1), foot_end, 0) new -> body FootL

// ==== Details: face, chest panel, fingers, toes (shallow, on the top faces)
box EyeR size 5 mm 2.5 mm 2 mm corner (2.5 mm, neck_y + 14 mm, T - 0.8 mm) cut targets Head
box EyeL size 5 mm 2.5 mm 2 mm corner (-7.5 mm, neck_y + 14 mm, T - 0.8 mm) cut targets Head
box Mouth size 10 mm 1.2 mm 2 mm corner (-5 mm, neck_y + 8 mm, T - 0.6 mm) cut targets Head
box Chest size 10 mm 16 mm 2 mm corner (-5 mm, 100 mm, T - 0.6 mm) cut targets Torso
cylinder Button1 radius 1.5 mm height 1 mm base (0, 104 mm, T - 0.6 mm) axis (0,0,1) join targets Torso
cylinder Button2 radius 1.5 mm height 1 mm base (0, 111 mm, T - 0.6 mm) axis (0,0,1) join targets Torso
box FingerR size 1.5 mm 8 mm (T + 2 mm) corner (arm_x0 + arm_w/2 - 0.75 mm, hand_end - 1 mm, -1 mm) cut targets HandR
box ToeR size (leg_w - 4 mm) 1 mm 2 mm corner (leg_x0 + 2 mm, foot_end + 4 mm, T - 0.6 mm) cut targets FootR
box FingerL size 1.5 mm 8 mm (T + 2 mm) corner ((-arm_x1) + arm_w/2 - 0.75 mm, hand_end - 1 mm, -1 mm) cut targets HandL
box ToeL size (leg_w - 4 mm) 1 mm 2 mm corner ((-leg_x1) + 2 mm, foot_end + 4 mm, T - 0.6 mm) cut targets FootL

// ==== Joints
// ---- Neck: hinge at y = neck_y, Torso has the outer knuckles and pins, Head the middle knuckle
box NeckNotch size ((neck_w/2) - (-neck_w/2) - 2*ko + 0.1 mm) (rk + clearance + 40 mm) (T + 2 mm) corner ((-neck_w/2) + ko - 0.05 mm, neck_y - rk - clearance, -1 mm) cut targets Torso
box NeckTrimP size ((neck_w/2) - (-neck_w/2) + 40 mm) (40 mm + rk*sin(45 deg) + 0.2 mm) (T + 2 mm) corner ((-neck_w/2) - 20 mm, neck_y - rk*sin(45 deg) - 0.2 mm, -1 mm) cut targets Torso
box NeckTrimC size ((neck_w/2) - (-neck_w/2) + 40 mm) (40 mm + rk*sin(45 deg) + 0.2 mm) (T + 2 mm) corner ((-neck_w/2) - 20 mm, neck_y - 40 mm, -1 mm) cut targets Head
box NeckStripA size (20 mm + ko + clearance + 0.05 mm) (40 mm + rk + clearance) (T + 2 mm) corner ((-neck_w/2) - 20 mm, neck_y - 40 mm, -1 mm) cut targets Head
box NeckStripB size (20 mm + ko + clearance + 0.05 mm) (40 mm + rk + clearance) (T + 2 mm) corner ((neck_w/2) - ko - clearance - 0.05 mm, neck_y - 40 mm, -1 mm) cut targets Head
sketch NeckKnuckleSk on YZ offset ((-neck_w/2) + 0.05 mm) {
  line base = (neck_y - rk*sin(45 deg), 0) (neck_y + rk*sin(45 deg), 0)
  arc top = start base.end through (neck_y, zh + rk) end base.start
  fix base top
}
extrude NeckKnuckleA from NeckKnuckleSk distance (ko - 0.05 mm) join targets Torso
extrude NeckKnuckleB from NeckKnuckleSk distance (ko - 0.05 mm) offset ((neck_w/2) - (-neck_w/2) - ko - 0.05 mm) join targets Torso
extrude NeckKnuckleM from NeckKnuckleSk distance ((neck_w/2) - (-neck_w/2) - 2*ko - 2*clearance) offset (ko + clearance - 0.05 mm) join targets Head
cone NeckPinA diameter (2*rc + 1 mm) top_radius tip height (rc - tip + 0.5 mm) base ((-neck_w/2) + ko - 0.5 mm, neck_y, zh) axis X join targets Torso
cone NeckPinB diameter (2*tip) top_radius (rc + 0.5 mm) height (rc - tip + 0.5 mm) base ((neck_w/2) - ko - rc + tip, neck_y, zh) axis X join targets Torso
cone NeckSocketA diameter (2*(rc + clearance*sqrt(2)) + 0.2 mm) top_radius tip height (rc + clearance*sqrt(2) - tip + 0.1 mm) base ((-neck_w/2) + ko - 0.1 mm, neck_y, zh) axis X cut targets Head
cone NeckSocketB diameter (2*tip) top_radius (rc + clearance*sqrt(2) + 0.1 mm) height (rc + clearance*sqrt(2) - tip + 0.1 mm) base ((neck_w/2) - ko - rc - c2 + tip, neck_y, zh) axis X cut targets Head
// ---- ShoulderTurretR: turret about Z at (shoulder_x, shoulder_y), the stem and head on Torso, the disc on ShoulderR
cylinder ShoulderTurretRPocket radius (disc_r + clearance) height (T + 2 mm) base (shoulder_x, shoulder_y, floor_t) axis (0,0,1) cut targets Torso
cylinder ShoulderTurretRDisc radius disc_r height (T - floor_t - clearance - 0.05 mm) base (shoulder_x, shoulder_y, floor_t + clearance) axis (0,0,1) join targets ShoulderR
cylinder ShoulderTurretRHole radius (stem_r + clearance) height (T + 2 mm) base (shoulder_x, shoulder_y, -1 mm) axis (0,0,1) cut targets ShoulderR
cone ShoulderTurretRSink diameter (2*(stem_r + clearance*sqrt(2) - 0.6 mm)) top_radius (head_r + clearance*sqrt(2) + 0.5 mm) height (head_r - stem_r + 1.1 mm) base (shoulder_x, shoulder_y, T - (head_r - stem_r) - 0.6 mm) axis Z cut targets ShoulderR
cylinder ShoulderTurretRStem radius stem_r height (T - (head_r - stem_r) - floor_t + 0.3 mm) base (shoulder_x, shoulder_y, floor_t - 0.2 mm) axis (0,0,1) join targets Torso
cone ShoulderTurretRHead diameter (2*stem_r) top_radius head_r height (head_r - stem_r) base (shoulder_x, shoulder_y, T - (head_r - stem_r)) axis Z join targets Torso
// ---- ShoulderHingeR: hinge at y = shoulder_hinge_y, ShoulderR has the outer knuckles and pins, UpperArmR the middle knuckle
box ShoulderHingeRNotch size (arm_x1 - arm_x0 - 2*ko + 0.1 mm) (rk + clearance + 40 mm) (T + 2 mm) corner (arm_x0 + ko - 0.05 mm, shoulder_hinge_y - 40 mm, -1 mm) cut targets ShoulderR
box ShoulderHingeRTrimP size (arm_x1 - arm_x0 + 40 mm) (40 mm + rk*sin(45 deg) + 0.2 mm) (T + 2 mm) corner (arm_x0 - 20 mm, shoulder_hinge_y - 40 mm, -1 mm) cut targets ShoulderR
box ShoulderHingeRTrimC size (arm_x1 - arm_x0 + 40 mm) (40 mm + rk*sin(45 deg) + 0.2 mm) (T + 2 mm) corner (arm_x0 - 20 mm, shoulder_hinge_y - rk*sin(45 deg) - 0.2 mm, -1 mm) cut targets UpperArmR
box ShoulderHingeRStripA size (20 mm + ko + clearance + 0.05 mm) (40 mm + rk + clearance) (T + 2 mm) corner (arm_x0 - 20 mm, shoulder_hinge_y - rk - clearance, -1 mm) cut targets UpperArmR
box ShoulderHingeRStripB size (20 mm + ko + clearance + 0.05 mm) (40 mm + rk + clearance) (T + 2 mm) corner (arm_x1 - ko - clearance - 0.05 mm, shoulder_hinge_y - rk - clearance, -1 mm) cut targets UpperArmR
sketch ShoulderHingeRKnuckleSk on YZ offset (arm_x0 + 0.05 mm) {
  line base = (shoulder_hinge_y - rk*sin(45 deg), 0) (shoulder_hinge_y + rk*sin(45 deg), 0)
  arc top = start base.end through (shoulder_hinge_y, zh + rk) end base.start
  fix base top
}
extrude ShoulderHingeRKnuckleA from ShoulderHingeRKnuckleSk distance (ko - 0.05 mm) join targets ShoulderR
extrude ShoulderHingeRKnuckleB from ShoulderHingeRKnuckleSk distance (ko - 0.05 mm) offset (arm_x1 - arm_x0 - ko - 0.05 mm) join targets ShoulderR
extrude ShoulderHingeRKnuckleM from ShoulderHingeRKnuckleSk distance (arm_x1 - arm_x0 - 2*ko - 2*clearance) offset (ko + clearance - 0.05 mm) join targets UpperArmR
cone ShoulderHingeRPinA diameter (2*rc + 1 mm) top_radius tip height (rc - tip + 0.5 mm) base (arm_x0 + ko - 0.5 mm, shoulder_hinge_y, zh) axis X join targets ShoulderR
cone ShoulderHingeRPinB diameter (2*tip) top_radius (rc + 0.5 mm) height (rc - tip + 0.5 mm) base (arm_x1 - ko - rc + tip, shoulder_hinge_y, zh) axis X join targets ShoulderR
cone ShoulderHingeRSocketA diameter (2*(rc + clearance*sqrt(2)) + 0.2 mm) top_radius tip height (rc + clearance*sqrt(2) - tip + 0.1 mm) base (arm_x0 + ko - 0.1 mm, shoulder_hinge_y, zh) axis X cut targets UpperArmR
cone ShoulderHingeRSocketB diameter (2*tip) top_radius (rc + clearance*sqrt(2) + 0.1 mm) height (rc + clearance*sqrt(2) - tip + 0.1 mm) base (arm_x1 - ko - rc - c2 + tip, shoulder_hinge_y, zh) axis X cut targets UpperArmR
// ---- ElbowR: hinge at y = elbow_y, UpperArmR has the outer knuckles and pins, ForearmR the middle knuckle
box ElbowRNotch size (arm_x1 - arm_x0 - 2*ko + 0.1 mm) (rk + clearance + 40 mm) (T + 2 mm) corner (arm_x0 + ko - 0.05 mm, elbow_y - 40 mm, -1 mm) cut targets UpperArmR
box ElbowRTrimP size (arm_x1 - arm_x0 + 40 mm) (40 mm + rk*sin(45 deg) + 0.2 mm) (T + 2 mm) corner (arm_x0 - 20 mm, elbow_y - 40 mm, -1 mm) cut targets UpperArmR
box ElbowRTrimC size (arm_x1 - arm_x0 + 40 mm) (40 mm + rk*sin(45 deg) + 0.2 mm) (T + 2 mm) corner (arm_x0 - 20 mm, elbow_y - rk*sin(45 deg) - 0.2 mm, -1 mm) cut targets ForearmR
box ElbowRStripA size (20 mm + ko + clearance + 0.05 mm) (40 mm + rk + clearance) (T + 2 mm) corner (arm_x0 - 20 mm, elbow_y - rk - clearance, -1 mm) cut targets ForearmR
box ElbowRStripB size (20 mm + ko + clearance + 0.05 mm) (40 mm + rk + clearance) (T + 2 mm) corner (arm_x1 - ko - clearance - 0.05 mm, elbow_y - rk - clearance, -1 mm) cut targets ForearmR
sketch ElbowRKnuckleSk on YZ offset (arm_x0 + 0.05 mm) {
  line base = (elbow_y - rk*sin(45 deg), 0) (elbow_y + rk*sin(45 deg), 0)
  arc top = start base.end through (elbow_y, zh + rk) end base.start
  fix base top
}
extrude ElbowRKnuckleA from ElbowRKnuckleSk distance (ko - 0.05 mm) join targets UpperArmR
extrude ElbowRKnuckleB from ElbowRKnuckleSk distance (ko - 0.05 mm) offset (arm_x1 - arm_x0 - ko - 0.05 mm) join targets UpperArmR
extrude ElbowRKnuckleM from ElbowRKnuckleSk distance (arm_x1 - arm_x0 - 2*ko - 2*clearance) offset (ko + clearance - 0.05 mm) join targets ForearmR
cone ElbowRPinA diameter (2*rc + 1 mm) top_radius tip height (rc - tip + 0.5 mm) base (arm_x0 + ko - 0.5 mm, elbow_y, zh) axis X join targets UpperArmR
cone ElbowRPinB diameter (2*tip) top_radius (rc + 0.5 mm) height (rc - tip + 0.5 mm) base (arm_x1 - ko - rc + tip, elbow_y, zh) axis X join targets UpperArmR
cone ElbowRSocketA diameter (2*(rc + clearance*sqrt(2)) + 0.2 mm) top_radius tip height (rc + clearance*sqrt(2) - tip + 0.1 mm) base (arm_x0 + ko - 0.1 mm, elbow_y, zh) axis X cut targets ForearmR
cone ElbowRSocketB diameter (2*tip) top_radius (rc + clearance*sqrt(2) + 0.1 mm) height (rc + clearance*sqrt(2) - tip + 0.1 mm) base (arm_x1 - ko - rc - c2 + tip, elbow_y, zh) axis X cut targets ForearmR
// ---- WristR: hinge at y = wrist_y, ForearmR has the outer knuckles and pins, HandR the middle knuckle
box WristRNotch size (arm_x1 - arm_x0 - 2*ko + 0.1 mm) (rk + clearance + 40 mm) (T + 2 mm) corner (arm_x0 + ko - 0.05 mm, wrist_y - 40 mm, -1 mm) cut targets ForearmR
box WristRTrimP size (arm_x1 - arm_x0 + 40 mm) (40 mm + rk*sin(45 deg) + 0.2 mm) (T + 2 mm) corner (arm_x0 - 20 mm, wrist_y - 40 mm, -1 mm) cut targets ForearmR
box WristRTrimC size (arm_x1 - arm_x0 + 40 mm) (40 mm + rk*sin(45 deg) + 0.2 mm) (T + 2 mm) corner (arm_x0 - 20 mm, wrist_y - rk*sin(45 deg) - 0.2 mm, -1 mm) cut targets HandR
box WristRStripA size (20 mm + ko + clearance + 0.05 mm) (40 mm + rk + clearance) (T + 2 mm) corner (arm_x0 - 20 mm, wrist_y - rk - clearance, -1 mm) cut targets HandR
box WristRStripB size (20 mm + ko + clearance + 0.05 mm) (40 mm + rk + clearance) (T + 2 mm) corner (arm_x1 - ko - clearance - 0.05 mm, wrist_y - rk - clearance, -1 mm) cut targets HandR
sketch WristRKnuckleSk on YZ offset (arm_x0 + 0.05 mm) {
  line base = (wrist_y - rk*sin(45 deg), 0) (wrist_y + rk*sin(45 deg), 0)
  arc top = start base.end through (wrist_y, zh + rk) end base.start
  fix base top
}
extrude WristRKnuckleA from WristRKnuckleSk distance (ko - 0.05 mm) join targets ForearmR
extrude WristRKnuckleB from WristRKnuckleSk distance (ko - 0.05 mm) offset (arm_x1 - arm_x0 - ko - 0.05 mm) join targets ForearmR
extrude WristRKnuckleM from WristRKnuckleSk distance (arm_x1 - arm_x0 - 2*ko - 2*clearance) offset (ko + clearance - 0.05 mm) join targets HandR
cone WristRPinA diameter (2*rc + 1 mm) top_radius tip height (rc - tip + 0.5 mm) base (arm_x0 + ko - 0.5 mm, wrist_y, zh) axis X join targets ForearmR
cone WristRPinB diameter (2*tip) top_radius (rc + 0.5 mm) height (rc - tip + 0.5 mm) base (arm_x1 - ko - rc + tip, wrist_y, zh) axis X join targets ForearmR
cone WristRSocketA diameter (2*(rc + clearance*sqrt(2)) + 0.2 mm) top_radius tip height (rc + clearance*sqrt(2) - tip + 0.1 mm) base (arm_x0 + ko - 0.1 mm, wrist_y, zh) axis X cut targets HandR
cone WristRSocketB diameter (2*tip) top_radius (rc + clearance*sqrt(2) + 0.1 mm) height (rc + clearance*sqrt(2) - tip + 0.1 mm) base (arm_x1 - ko - rc - c2 + tip, wrist_y, zh) axis X cut targets HandR
// ---- HipHingeR: hinge at y = hip_hinge_y, HipR has the outer knuckles and pins, ThighR the middle knuckle
box HipHingeRNotch size (leg_x1 - leg_x0 - 2*ko + 0.1 mm) (rk + clearance + 40 mm) (T + 2 mm) corner (leg_x0 + ko - 0.05 mm, hip_hinge_y - 40 mm, -1 mm) cut targets HipR
box HipHingeRTrimP size (leg_x1 - leg_x0 + 40 mm) (40 mm + rk*sin(45 deg) + 0.2 mm) (T + 2 mm) corner (leg_x0 - 20 mm, hip_hinge_y - 40 mm, -1 mm) cut targets HipR
box HipHingeRTrimC size (leg_x1 - leg_x0 + 40 mm) (40 mm + rk*sin(45 deg) + 0.2 mm) (T + 2 mm) corner (leg_x0 - 20 mm, hip_hinge_y - rk*sin(45 deg) - 0.2 mm, -1 mm) cut targets ThighR
box HipHingeRStripA size (20 mm + ko + clearance + 0.05 mm) (40 mm + rk + clearance) (T + 2 mm) corner (leg_x0 - 20 mm, hip_hinge_y - rk - clearance, -1 mm) cut targets ThighR
box HipHingeRStripB size (20 mm + ko + clearance + 0.05 mm) (40 mm + rk + clearance) (T + 2 mm) corner (leg_x1 - ko - clearance - 0.05 mm, hip_hinge_y - rk - clearance, -1 mm) cut targets ThighR
sketch HipHingeRKnuckleSk on YZ offset (leg_x0 + 0.05 mm) {
  line base = (hip_hinge_y - rk*sin(45 deg), 0) (hip_hinge_y + rk*sin(45 deg), 0)
  arc top = start base.end through (hip_hinge_y, zh + rk) end base.start
  fix base top
}
extrude HipHingeRKnuckleA from HipHingeRKnuckleSk distance (ko - 0.05 mm) join targets HipR
extrude HipHingeRKnuckleB from HipHingeRKnuckleSk distance (ko - 0.05 mm) offset (leg_x1 - leg_x0 - ko - 0.05 mm) join targets HipR
extrude HipHingeRKnuckleM from HipHingeRKnuckleSk distance (leg_x1 - leg_x0 - 2*ko - 2*clearance) offset (ko + clearance - 0.05 mm) join targets ThighR
cone HipHingeRPinA diameter (2*rc + 1 mm) top_radius tip height (rc - tip + 0.5 mm) base (leg_x0 + ko - 0.5 mm, hip_hinge_y, zh) axis X join targets HipR
cone HipHingeRPinB diameter (2*tip) top_radius (rc + 0.5 mm) height (rc - tip + 0.5 mm) base (leg_x1 - ko - rc + tip, hip_hinge_y, zh) axis X join targets HipR
cone HipHingeRSocketA diameter (2*(rc + clearance*sqrt(2)) + 0.2 mm) top_radius tip height (rc + clearance*sqrt(2) - tip + 0.1 mm) base (leg_x0 + ko - 0.1 mm, hip_hinge_y, zh) axis X cut targets ThighR
cone HipHingeRSocketB diameter (2*tip) top_radius (rc + clearance*sqrt(2) + 0.1 mm) height (rc + clearance*sqrt(2) - tip + 0.1 mm) base (leg_x1 - ko - rc - c2 + tip, hip_hinge_y, zh) axis X cut targets ThighR
// ---- HipTurretR: turret about Z at (hip_x, hip_y), the stem and head on Torso, the disc on HipR
cylinder HipTurretRPocket radius (disc_r + clearance) height (T + 2 mm) base (hip_x, hip_y, floor_t) axis (0,0,1) cut targets Torso
cylinder HipTurretRDisc radius disc_r height (T - floor_t - clearance - 0.05 mm) base (hip_x, hip_y, floor_t + clearance) axis (0,0,1) join targets HipR
cylinder HipTurretRHole radius (stem_r + clearance) height (T + 2 mm) base (hip_x, hip_y, -1 mm) axis (0,0,1) cut targets HipR
cone HipTurretRSink diameter (2*(stem_r + clearance*sqrt(2) - 0.6 mm)) top_radius (head_r + clearance*sqrt(2) + 0.5 mm) height (head_r - stem_r + 1.1 mm) base (hip_x, hip_y, T - (head_r - stem_r) - 0.6 mm) axis Z cut targets HipR
