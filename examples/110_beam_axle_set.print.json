{
  "version": 1,
  "defaults": false,
  "requests": [
    { "id": "print-3mf", "kind": "export", "format": "3mf", "layout": "plate" },
    { "id": "print-stl", "kind": "export", "format": "stl", "layout": "plate" },
    { "id": "preview-glb", "kind": "export", "format": "glb", "layout": "plate" },
    { "id": "print-check", "kind": "commands", "layout": "plate",
      "commands": [ { "command": "inspect.measure", "params": {} } ] },
    { "id": "plate-view", "kind": "snapshot", "layout": "plate", "options": { "view": "iso" } },
    { "id": "build-check", "kind": "commands",
      "commands": [ { "command": "inspect.interference", "params": {} } ] }
  ],
  "layouts": {
    "plate": {
      "spacing": "5 mm",
      "bed": [256, 256],
      "parts": [
        { "id": "lower", "select": { "bodies": ["Lower"] } },
        { "id": "upper", "select": { "bodies": ["Upper"] } },
        { "id": "spacer", "select": { "bodies": ["Spacer"] } },
        { "id": "base", "select": { "bodies": ["Base"] } },
        { "id": "pinion", "select": { "bodies": ["Pinion"] } },
        { "id": "wheel", "select": { "bodies": ["Wheel"] } },
        { "id": "axle-a", "select": { "bodies": ["AxleA"] }, "rotate": [{ "axis": [1, 0, 0], "angle": "90 deg" }] },
        { "id": "axle-b", "select": { "bodies": ["AxleB"] }, "rotate": [{ "axis": [0, 0, 1], "angle": "-9 deg" }, { "axis": [1, 0, 0], "angle": "90 deg" }] },
        { "id": "pin-a", "select": { "bodies": ["PinA"] }, "rotate": [{ "axis": [1, 0, 0], "angle": "90 deg" }] },
        { "id": "pin-b", "select": { "bodies": ["PinB"] }, "rotate": [{ "axis": [1, 0, 0], "angle": "90 deg" }] }
      ]
    }
  }
}
