{
  "version": 1,
  "defaults": false,
  "requests": [
    {"id": "print-3mf", "kind": "export", "format": "3mf", "layout": "plate"},
    {"id": "print-stl", "kind": "export", "format": "stl", "layout": "plate"},
    {"id": "preview-glb", "kind": "export", "format": "glb", "layout": "plate"},
    {"id": "print-check", "kind": "commands", "layout": "plate", "commands": [{"command": "inspect.measure", "params": {}}]},
    {"id": "fit-check", "kind": "commands", "commands": [{"command": "inspect.interference", "params": {}}]},
    {"id": "plate-view", "kind": "snapshot", "layout": "plate", "options": {"view": "iso"}}
  ],
  "layouts": {
    "plate": {
      "bed": [256, 256],
      "spacing": "6 mm",
      "parts": [
        {"id": "Bottom", "select": {"bodies": ["Bottom"]}},
        {"id": "Top", "select": {"bodies": ["Top"]}, "rotate": [{"axis": [1, 0, 0], "angle": "180 deg"}]},
        {"id": "Shutter", "select": {"bodies": ["Shutter"]}, "rotate": [{"axis": [1, 0, 0], "angle": "-90 deg"}]},
        {"id": "Spring", "select": {"bodies": ["Spring"]}, "rotate": [{"axis": [0, 1, 0], "angle": "90 deg"}]},
        {"id": "Slider", "select": {"bodies": ["Slider"]}, "rotate": [{"axis": [1, 0, 0], "angle": "180 deg"}]}
      ]
    }
  }
}
