extrude DiscBBody from DiscBOutline distance disc_t new -> body DiscB
cylinder DiscBCamBore radius (cam_r+cam_clear) height (disc_t+2 mm) base ((-ecc),0,disc_b_z-1 mm) cut targets DiscB
cylinder DiscBHole radius (out_pin_r+ecc+pin_hole_clear) height (disc_t+2 mm) base ((-ecc)+out_circle,0,disc_b_z-1 mm) cut targets DiscB
pattern circular DiscBHoles features DiscBHole origin ((-ecc),0,0) dir (0,0,1) count n_out angle 360 deg

// Eccentric cams with a D bore; the flat sits on the shaft's +X side for both
cylinder CamABody radius cam_r height disc_t base (ecc,0,disc_a_z) new -> body CamA
cylinder CamABore radius (in_r+d_fit) height (disc_t+2 mm) base (0,0,disc_a_z-1 mm) cut targets CamA
box CamAFlat size 1.5 mm (2*in_r+2 mm) disc_t corner (in_r-flat+d_fit,-in_r-1 mm,disc_a_z) join targets CamA
cylinder CamBBody radius cam_r height disc_t base (-ecc,0,disc_b_z) new -> body CamB
cylinder CamBBore radius (in_r+d_fit) height (disc_t+2 mm) base (0,0,disc_b_z-1 mm) cut targets CamB
box CamBFlat size 1.5 mm (2*in_r+2 mm) disc_t corner (in_r-flat+d_fit,-in_r-1 mm,disc_b_z) join targets CamB

// Input shaft: D-flat along its whole length so it prints lying on the flat
param in_below = 15 mm
let in_top = top_z + 3 mm
cylinder InputBody radius in_r height (in_top+in_below) base (0,0,-in_below) new -> body InputShaft
box InputFlat size 2 mm (2*in_r+2 mm) (in_top+in_below+2 mm) corner (in_r-flat,-in_r-1 mm,-in_below-1 mm) cut targets InputShaft

// Output base: plate with the output pins, each with an M3 pilot hole
cylinder BasePlate radius plate_r height base_t base (0,0,base_z) new -> body OutputBase
cylinder BaseHole radius (in_r+1 mm) height (base_t+2 mm) base (0,0,base_z-1 mm) cut targets OutputBase
cylinder OutPin radius out_pin_r height (top_z-base_z-base_t) base (out_circle,0,base_z+base_t) join targets OutputBase
