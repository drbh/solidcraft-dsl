// 15. Two-disc cycloidal drive, 19:1, printable and assembled with M3 screws.
//
// Input shaft (D-flat) carries two eccentric cams 180 deg apart. Each cam drives a 19-lobe
// cycloidal disc against 20 ring rollers; the rollers spin on M3 screws that also clamp the
// cover to the housing. Six output pins on the output carrier ride in the discs' holes and
// take out the discs' slow rotation: output = -input/19.
//
// Parts: Housing, Cover, InputShaft, CamA, CamB, DiscA, DiscB, OutputBase (with pins),
//        OutputTop (with output shaft), 20 rollers.
// Screws: 20 x M3x35 (ring pins, from the cover into the housing floor),
//          6 x M3x12 (OutputTop into the output pins), 4 x M3 for mounting through the ears.
// Fit is set by roller_clear, pin_hole_clear, cam_clear, shaft_clear and gap.
design CycloidalDrive units mm

// Reduction geometry
param n_pins = 20
param pin_circle = 40 mm
param roller_r = 3.5 mm
param ecc = 1.5 mm
param roller_clear = 0.25 mm
let roller_fit = roller_r + roller_clear
let ratio = n_pins - 1

// Output pins and cams
param n_out = 6
param out_circle = 22 mm
param out_pin_r = 4 mm
param pin_hole_clear = 0.25 mm
param cam_r = 9 mm
param cam_clear = 0.2 mm

// Stack, shafts and fits
param gap = 0.5 mm
param floor_t = 6 mm
param base_t = 4 mm
param disc_t = 7 mm
param top_t = 5 mm
param cover_t = 4 mm
param wall = 4 mm
param in_r = 4 mm
param flat = 0.8 mm
param d_fit = 0.1 mm
param shaft_clear = 0.25 mm
param out_r = 6 mm
param out_len = 20 mm
param m3_pilot = 2.5 mm
param m3_clear = 3.4 mm
param m3_free = 3.5 mm
param m3_head = 6.5 mm
param m3_head_h = 3.3 mm
let base_z = floor_t + gap
let disc_a_z = base_z + base_t + gap
let disc_b_z = disc_a_z + disc_t + gap
let top_z = disc_b_z + disc_t + gap
let wall_h = top_z + top_t + gap
let wall_in = pin_circle + roller_r + 1 mm
let wall_out = wall_in + wall
let plate_r = pin_circle - roller_r - 1.5 mm

