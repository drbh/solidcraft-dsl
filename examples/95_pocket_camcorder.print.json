        { "id": "KeyRight", "select": { "bodies": ["KeyRight"] } },
        { "id": "KeyPlay", "select": { "bodies": ["KeyPlay"] } },
        { "id": "KeyDelete", "select": { "bodies": ["KeyDelete"] } },
        { "id": "UsbArm", "select": { "bodies": ["UsbArm"] } },
        { "id": "LensRing", "select": { "bodies": ["LensRing"] } }
