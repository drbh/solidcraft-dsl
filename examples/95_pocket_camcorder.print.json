        { "id": "Camcorder", "select": { "bodies": ["Back", "Front", "Record", "KeyUp", "KeyDown", "KeyLeft", "KeyRight", "KeyPlay", "KeyDelete", "UsbArm", "UsbPlug", "LensRing", "Tft"] } }
